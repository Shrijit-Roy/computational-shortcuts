    {
      "cell_type": "code",
      "source": [
        "#Binary\n",
        "x = int(input(\"                \"))\n",
        "y = \"\"\n",
        "for i in range(1, x + 1):\n",
        "    y = y + str(x % 2)\n",
        "    x = int(x / 2)\n",
        "    if x == 0:\n",
        "        break\n",
        "\n",
        "y_list = []\n",
        "\n",
        "j = len(y) - 1\n",
        "\n",
        "while j >= 0:\n",
        "    y_list.append(y[j])\n",
        "    j = j - 1\n",
        "\n",
        "m = \"\"\n",
        "for k in y_list:\n",
        "    m = m + k\n",
        "\n",
        "m = m.rstrip()\n",
        "print(m)\n"
      ],
      "metadata": {
        "id": "mHnJU_2y79is"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Factorization\n",
        "a = int(input())\n",
        "b = []\n",
        "for i in range(1, a + 1, 1):\n",
        "    if a % i == 0:\n",
        "        b.append(i)\n",
        "print(b)\n",
        "j = 0\n",
        "k = len(b) - 1\n",
        "while j <= len(b) / 2 and k >= len(b) / 2:\n",
        "    c = b[j]\n",
        "    d = b[k]\n",
        "    print(c, \"X\", d)\n",
        "    j = j + 1\n",
        "    k = k - 1\n"
      ],
