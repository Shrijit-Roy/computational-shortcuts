      "source": [
        "#Pythagorean Triples (Sides excluding hypotenuse)\n",
        "x = int(input())\n",
        "a = x * x\n",
        "b = []\n",
        "for i in range(1, a + 1, 1):\n",
        "    if a % i == 0:\n",
        "        b.append(i)\n",
        "j = 0\n",
        "k = len(b) - 1\n",
        "while j <= len(b) / 2 and k >= len(b) / 2:\n",
        "    c = b[j]\n",
        "    d = b[k]\n",
        "    e = d + c\n",
        "    f = d - c\n",
        "    j = j + 1\n",
        "    k = k - 1\n",
        "    if e % 2 == 0:\n",
        "        print(\"hyp= \", int(e / 2), \"  adj= \", int(f / 2))\n",
        "    else:\n",
        "        continue\n"
      ],
      "metadata": {
        "id": "s1EOxhTC8J4D"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Pythagorean Triplets (Hypotenuse and a side)\n",
        "import math\n",
        "\n",
        "x = int(input())\n",
        "b = 0\n",
        "for i in range(1, x + 2, 1):\n",
        "    a = x - b\n",
        "    c = a - b\n",
        "    c = a - b\n",
        "    d = 4 * a * b\n",
        "    e = math.sqrt(d)\n",
        "    if c >= 0:\n",
        "        if e.is_integer():\n",
        "            print(\"Base=\", c, \"Height=\", int(e))\n",
        "        b = b + 1\n",
        "        continue\n",
        "    elif c < 0:\n",
        "        b = b + 1\n",
        "        continue\n"
      ],
      "metadata": {
        "id": "H5fyhyHd8Z1X"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Atomic Spectrum Summary\n",
        "from fractions import Fraction\n",
        "n1=int(input(\"n1: \"))\n",
        "z=int(input(\"Z: \"))\n",
        "c=299792458\n",
        "R_h=10973731.568508\n",
        "min_neubar_frac=z**2*(Fraction(1,n1**2)-Fraction(1,(n1+1)**2))\n",
        "max_neubar_frac=z**2*Fraction(1,n1**2)\n",
        "min_neubar=R_h*min_neubar_frac\n",
        "max_neubar=R_h*max_neubar_frac\n",
        "print(min_neubar,\"m^-1 <= Wave number <\",max_neubar,\"m^-1\")\n",
        "print(min_neubar_frac,\"X Rydberg Constant <= Wave number <\",max_neubar_frac,\"X Rydberg Constant\")\n",
        "print(\"-------------------------------------------------------------------------------------------\")\n",
        "print(10**9/(max_neubar),\"nm <Wavelength <=\",10**9/(min_neubar),\"nm \")\n",
        "print(f\"{1/max_neubar_frac} X 10^9/Rydberg Constant (nm)< Wavelength<={1/min_neubar_frac} X 10^9/Rydberg Constant (nm)\")\n",
        "print(\"-------------------------------------------------------------------------------------------\")\n",
        "print(f\"{c*min_neubar}Hz <= Frequency <{c*max_neubar} Hz\")\n",
        "print(min_neubar_frac,\"X c X Rydberg Constant <= Frequency <\",max_neubar_frac,\"X c X Rydberg Constant\")\n",
        "max_wave=10**9/min_neubar\n",
        "min_wave=10**9/max_neubar\n",
        "if max_wave<0.01:\n",
        "    print(\"Gamma Ray\")\n",
        "elif min_wave<0.01 and max_wave>0.01 and max_wave<10:\n",
        "    print(\"X-Ray and Gamma Ray\")\n",
        "elif min_wave>0.01 and max_wave<10:\n",
        "    print(\"X-Ray\")\n",
        "elif min_wave>0.01 and min_wave<10 and max_wave>10 and max_wave<380:\n",
        "    print(\"X_Ray and UV Ray\")\n",
        "elif min_wave>10 and max_wave<380:\n",
        "    print(\"UV Ray\")\n",
        "elif min_wave>10 and min_wave<380 and max_wave>380 and max_wave<780:\n",
        "    print(\"UV Ray and Visible Ray\")\n",
        "    if max_wave<424:\n",
        "        print(\"Only Violet\")\n",
        "    elif max_wave<450:\n",
        "        print(\"Violet to Indigo\")\n",
        "    elif max_wave<500:\n",
        "        print(\"Violet to Blue\")\n",
        "    elif max_wave<575:\n",
        "        print(\"Violet to Green\")\n",
        "    elif max_wave<590:\n",
        "        print(\"Violet to Yellow\")\n",
        "    elif max_wave<647:\n",
        "        print(\"Violet to Orange\")\n",
        "    else:\n",
        "        print(\"Violet to Red\")\n",
        "elif min_wave>380 and max_wave<780:\n",
        "    print(\"Visible Ray\")\n",
        "    if max_wave<424:\n",
        "        a=\"Violet\"\n",
        "        if min_wave<424:\n",
